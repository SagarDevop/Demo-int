# ====================================================================
# 4 LOTUS INTERIOR - PRODUCTION HOSTINGER APACHE CONFIGURATION
# ====================================================================

# Prevent directory indexing
Options -Indexes

# Set default character set
AddDefaultCharset UTF-8

# Custom 404 Error Document (genuine HTTP 404 status from Next.js export)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Redirect legacy /contact alias to primary canonical /contact-us
  RewriteRule ^contact(?:\.html)?/?$ /contact-us [R=301,L]

  # 2. 301 Redirect regional shortcut aliases to full canonical clean URLs
  RewriteRule ^interior-designers-noida(?:\.html)?/?$ /interior-designers-decorators-in-noida [R=301,L]
  RewriteRule ^interior-designers-delhi(?:\.html)?/?$ /interior-designers-decorators-in-delhi [R=301,L]
  RewriteRule ^interior-designers-gurgaon(?:\.html)?/?$ /interior-designers-decorators-in-gurgaon [R=301,L]
  RewriteRule ^interior-designers-faridabad(?:\.html)?/?$ /interior-designers-decorators-in-faridabad [R=301,L]
  RewriteRule ^interior-designers-sonipat(?:\.html)?/?$ /interior-designers-decorators-in-sonipat [R=301,L]
  RewriteRule ^interior-designers-ghaziabad(?:\.html)?/?$ /interior-designers-decorators-in-ghaziabad [R=301,L]

  # 3. 301 Redirect legacy .html URLs to clean URLs (exclude 404.html)
  # Uses THE_REQUEST so it only catches direct client requests, preventing redirect loops with internal rewrites
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 4. Existing physical files or directories (assets, images, _next chunks, etc.) - serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Clean URL internal rewrites: Serve corresponding .html file if it exists
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Unmatched requests fall through to Apache ErrorDocument 404 /404.html
</IfModule>

# Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching Headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
